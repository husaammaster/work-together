# Kopiere diese Datei nach .env und passe die Werte an:  cp .env.example .env
# Die .env wird von Docker Compose (couchdb + backend) und vom lokal gestarteten
# Backend gelesen.

# CouchDB-Zugangsdaten (admin-Account des couchdb-Containers)
COUCHDB_USER=admin
COUCHDB_PASSWORD=password

# Adresse, unter der das Backend CouchDB erreicht:
#   - via docker compose:        couchdb:5984   (Compose-Servicename)
#   - Backend lokal (node):      localhost:5984
COUCHDB_URL=couchdb:5984
